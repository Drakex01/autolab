# AutoLab Environment Configuration

# Google Gemini API Key (Required for AI planning and interpretation)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (e.g. gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Document RAG Settings
AUTOLAB_CHUNK_SIZE=800
AUTOLAB_CHUNK_OVERLAP=120
AUTOLAB_EMBEDDING_MODEL=all-MiniLM-L6-v2
AUTOLAB_MAX_UPLOAD_SIZE_MB=20
AUTOLAB_TOP_K_RETRIEVAL=5
