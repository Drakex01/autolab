# AutoLab Environment Configuration

# Default Local LLM Provider ('ollama' for offline local AI, or 'gemini' for optional cloud)
LLM_PROVIDER=ollama

# Local Ollama Settings (recommended for 16 GB RAM / RTX 3050 4 GB VRAM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=360
OLLAMA_KEEP_ALIVE=5m

# Optional Cloud Gemini Configuration (only used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Document RAG Settings
AUTOLAB_CHUNK_SIZE=800
AUTOLAB_CHUNK_OVERLAP=120
AUTOLAB_EMBEDDING_MODEL=all-MiniLM-L6-v2
AUTOLAB_MAX_UPLOAD_SIZE_MB=20
AUTOLAB_TOP_K_RETRIEVAL=5
